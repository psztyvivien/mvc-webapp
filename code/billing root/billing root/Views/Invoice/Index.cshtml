@using billing_root.Models
@model IEnumerable<Invoice>;

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <title>Invoices</title>
    <style>
        body {
        margin: 40px;
        }
    </style>
</head>
<body>
    <h1>LIST INVOICES</h1>
    <hr />
    <a href="/invoice/create" class="btn btn-sm btn-primary">Create</a>
    <hr />
    <div class="container mt-4">
        @if(Model.FirstOrDefault() != null)
        {

            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Payer name</th>
                        <th>Amount (HUF)</th>
                        <th>Is Paid</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Invoice invoice in Model)
                    {
                        @:<tr>
                        @:<td>@invoice.Id</td>
                        @:<td>@invoice.PayerName</td>
                        @:<td>@invoice.Amount</td>
                        <td>
                            @if (invoice.IsPaid)
                            {
                                <span class="text-success fw-bold">✔</span>
                            }
                            else
                            {
                                <span class="text-danger fw-bold">✖</span>
                            }
                        </td>
                        <td>
                            <a href="/invoice/update?id=@invoice.Id" class="btn btn-small btn-warning">Edit</a>
                            @*<a href="/invoice/markaspaid?id=@invoice.Id" class="btn btn-sm btn-primary">Mark as paid</a>*@

                            @*csak akkor jelenjen meg a Mark as paid gomb, ha nincs fizetve, különben ne jelenjen meg!*@
                            @if (!invoice.IsPaid)
                            {
                                <a href="/invoice/markaspaid?id=@invoice.Id" class="btn btn-small btn-primary">Mark as paid</a>
                            }

                                <a href="/invoice/delete?id=@invoice.Id" class="btn btn-sm btn-danger">Delete</a>
                            </td>
                        @:</tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-info">There are no invoices in the system!</p>
        }
    </div>
</body>
</html>