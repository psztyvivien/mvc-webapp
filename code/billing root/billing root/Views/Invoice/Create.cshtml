@using billing_root.Models
@model Invoice;

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <title>Invoices</title>
    <style>
        body {
            margin: 40px;
        }
    </style>
</head>
<body>
    <h1>CREATE INVOICES</h1>
    <hr />
    <div class="container mt-4">
        <form action="create" method="post" class="mt-4">
            <input value="@Model?.Id" name="Id" type="number" placeholder="ID" class="form-control"/>
            <br />
            <input value="@Model?.PayerName" name="PayerName" type="text" placeholder="Name" class="form-control"/>
            <br />
            <input value="@Model?.Amount" type="number" name="Amount" placeholder="Amount"/>
            <br />
            Paid:
            @Html.CheckBoxFor(x=>x.IsPaid, new {@class = "form-check"})
            <br />
            <input type="submit" value="Create" class="btn btn-success btn-lg mt-5" />
        </form>
    </div>
    <script>
        //akkor fut le, ha a teljes HTML oldal betöltődött
        document.addEventListener('DOMContentLoaded', function(){
            const payerNameInput = document.querySelector('input[name="PayerName"]');
            const amountInput = document.querySelector('input[name="Amount"]');
            const submitButton = document.querySelector('input[type="submit"]');

            function validateForm() {
                const payerName = payerNameInput.value.trim();
                const amount = parseFloat(amountInput.value);

                //név ne legyen üres, és a max hossza 50 karakter legyen
                const isPayerNameValid = payerName.length > 0 && payerName.length <= 50;

                //szám ne legyen más típusú (csak szám) és csak pozitív szám legyen
                const isAmountValid = !isNaN(amount) && amount > 0;


                //ha nem teljesül egyik feltétel se, akkor a create gomb le van tiltva
                submitButton.disabled = !(isPayerNameValid && isAmountValid);
            }


            //gépeléskor figyeli a beviteli mezőket a validáció
            payerNameInput.addEventListener('input', validateForm);
            amountInput.addEventListener('input', validateForm);

            validateForm(); //futás után az ellenőrzés egyből megkezdődik
        });
    </script>
</body>
</html>